# Configuración para Demo Local
FLASK_CONFIG=development
SECRET_KEY=demo-secret-key-change-in-production
JWT_SECRET_KEY=demo-jwt-secret-key-change-in-production

# Base de datos SQLite para demo local (sin necesidad de MySQL)
DATABASE_URL=sqlite:///upec_cms_demo.db

# Carpeta de uploads
UPLOAD_FOLDER=./uploads

# YouTube API (opcional para la demo - deja vacío si no tienes API key)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_UPLOADS_PLAYLIST_ID=

# Icecast Status (opcional para la demo)
ICECAST_STATUS_URL=http://127.0.0.1:8000/status-json.xsl

# CORS - permite el frontend local
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
